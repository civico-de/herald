# LF everywhere the tooling reads bytes: ckinit --check compares managed files
# byte-for-byte against the template, so a CRLF checkout would read as
# permanent drift. text=auto keeps genuine binaries untouched.
* text=auto
*.php text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary media goes through Git LFS, which keeps its history out of every
# clone; ckconform's media-lfs check holds the repo to it. SVG is text and
# stays in git.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
