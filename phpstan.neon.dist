parameters:
	level: 10
	# Analyse against the declared PHP floor, not the image's PHP.
	phpVersion: 80300
	# PHPDoc array shapes (APIv4 rows, decoded JSON) describe what the data
	# IS, but defensive runtime checks (is_array on decoded JSON) must not be
	# reported as redundant because of them. Also: PEAR-era signatures lie in
	# their PHPDocs (a documented "array" can be a PEAR_Error).
	treatPhpDocTypesAsCertain: false
	# A typed property with no default is a runtime Error waiting for the one
	# path that reads it before writing it; APIv4 action parameters are exempt.
	checkUninitializedProperties: true
	paths:
		- Civi
		- CRM
		- managed
		- herald.php
	excludePaths:
		analyse:
			# civix-generated stubs; the DAO base class is created at runtime
			- CRM/*/DAO/*
			- CRM/*/BAO/*
	scanFiles:
		- herald.civix.php
	scanDirectories:
		# CiviRules base classes (parents of the herald actions/conditions/forms)
		# live off the classloader path in the dev container.
		- /var/www/html/ext/org.civicoop.civirules
		# Core ships APIv4 entities from its bundled extensions, not only from
		# Civi/Api4 proper — Civi\Api4\Contribution lives in civi_contribute.
		# Without this every call on such an entity is class.notFound, and the
		# whole fluent chain after it degrades to mixed.
		- /var/www/html/core/ext
	bootstrapFiles:
		- phpstanBootstrap.php
		# Repo-specific half (Smarty preload, the extension-class autoloader and
		# the CiviRules DAO alias) — kept out of the template-managed file above,
		# which ckinit --update rewrites wholesale.
		- phpstanBootstrap.local.php
	# ignoreErrors: only ever narrowly scoped (identifier + path + count) and
	# carrying a comment that says WHY the report is wrong — never blanket
	# patterns, never a baseline file.
	ignoreErrors:
		# CiviRules registers handlers by inheritance (instanceof check in
		# CRM_Civirules_BAO_CiviRulesAction::getActionObjectById); no APIv4
		# registration exists — thin adapters only, domain logic sits behind
		# APIv4. The path is the whole of the adapter layer and nothing else:
		# outside it the rule still forbids every CiviRules reference, which is
		# what keeps the adapters thin.
		-
			identifier: phpat.testOnlyCoreAndOwnCivicrmDependencies
			paths:
				- CRM/Herald/CivirulesAdapter/*
		# Same boundary, other half: CiviRules' action/condition parameter
		# screens ARE QuickForm — CRM_CivirulesActions_Form_Form extends
		# CRM_Core_Form, and CiviRules opens them by route. There is no
		# SearchKit/Afform equivalent to migrate to.
		-
			identifier: phpat.testNoLegacyUiBases
			paths:
				- CRM/Herald/CivirulesAdapter/Form/*
