<?xml version="1.0"?>
<ruleset name="herald">
  <description>civicrm/coder ruleset, scoped to non-generated source.</description>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="p"/>

  <file>Civi</file>
  <file>CRM</file>
  <file>herald.php</file>

  <exclude-pattern>herald.civix.php</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>tests/phpunit/bootstrap.php</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <rule ref="Drupal.Commenting.DocComment.MissingShort">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.FunctionComment.Missing">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.ClassComment.Missing">
    <severity>0</severity>
  </rule>
</ruleset>
