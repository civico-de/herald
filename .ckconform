# Expected values for ckconform (the checker lives in the public civikitchen
# image; these values are ours and stay in this private repo).
license=Proprietary
npm_license=UNLICENSED
copyright=civico GmbH

# Measured 2026-07-21 after the level-10 pass: 54.55% (623/1142 lines).
# Raise it as coverage grows — never lower it to make a build green.
min_coverage=54

template_custom=.docker/docker-compose.ci.yml -- CiviRules is a hard dependency of herald, so the CI stack downloads it (CIVIKITCHEN_EXTRA_EXTENSIONS) before enabling the extension
