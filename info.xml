<?xml version="1.0"?>
<extension key="herald" type="module">
  <file>herald</file>
  <name>Herald</name>
  <description>Generic notification + digest layer for CiviCRM. Channel-pluggable (Telegram, Webhook, ntfy.sh, Pushover, Email, CiviCRM activities), template-driven, CiviRules-integrated.</description>
  <license>AGPL-3.0-or-later</license>
  <authors>
    <author>
      <name>Johannes Filter (civico GmbH)</name>
      <email>johannes@civico.de</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/civico-de/herald</url>
    <url desc="Documentation">https://civico-de.github.io/herald/</url>
    <url desc="Support">https://github.com/civico-de/herald/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-27</releaseDate>
  <version>0.14.0</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>6.18</ver>
  </compatibility>
  <php_compatibility mode="list">
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <comments>CiviRules is optional: with it, rules send notifications and scheduled digests.</comments>
  <requires>
    <!-- The parked-alerts and digest lists ship as SearchKit displays. -->
    <ext>org.civicrm.search_kit</ext>
    <!-- Digests are edited in an Afform. -->
    <ext>org.civicrm.afform</ext>
  </requires>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Herald</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>ang-php@1.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\Herald\AutomaticUpgrader</upgrader>
</extension>
