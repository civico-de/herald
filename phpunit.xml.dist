<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  bootstrap="tests/phpunit/bootstrap.php"
  colors="true"
  convertErrorsToExceptions="true"
  convertNoticesToExceptions="true"
  convertWarningsToExceptions="true">
  <coverage>
    <!-- Scoped to real extension code: the civix shim and DAO boilerplate
         would otherwise dilute the numbers into meaninglessness. -->
    <include>
      <directory suffix=".php">./Civi</directory>
      <directory suffix=".php">./CRM</directory>
      <file>./herald.php</file>
    </include>
    <exclude>
      <file>./herald.civix.php</file>
    </exclude>
  </coverage>
  <testsuites>
    <testsuite name="herald">
      <directory>tests/phpunit</directory>
    </testsuite>
  </testsuites>
  <listeners>
    <!-- Boots headless tests (HeadlessInterface) against TEST_DB_DSN and
         drives TransactionalInterface. Without it nothing boots Civi. -->
    <listener class="Civi\Test\CiviTestListener">
      <arguments/>
    </listener>
  </listeners>
</phpunit>
