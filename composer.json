{
    "name": "jfilter/civico_notify",
    "description": "Generic notification + digest layer for CiviCRM. Channel-pluggable (Telegram first), template-driven, CiviRules-integrated.",
    "type": "civicrm-ext",
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "Johannes Filter",
            "email": "hi@jfilter.de"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Civi\\CivicoNotify\\": "Civi/CivicoNotify/"
        },
        "psr-0": {
            "CRM_": "."
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Civi\\CivicoNotify\\": "tests/phpunit/Civi/CivicoNotify/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
