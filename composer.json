{
    "name": "civico-de/herald",
    "description": "Generic notification + digest layer for CiviCRM. Channel-pluggable (Telegram, Webhook, ntfy.sh, Pushover, Email, CiviCRM activities), template-driven, CiviRules-integrated.",
    "type": "civicrm-ext",
    "license": "proprietary",
    "authors": [
        {
            "name": "Johannes Filter",
            "email": "hi@jfilter.de"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Civi\\Herald\\": "Civi/Herald/"
        },
        "psr-0": {
            "CRM_": "."
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Civi\\Herald\\": "tests/phpunit/Civi/Herald/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
