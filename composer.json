{
    "name": "civico-de/herald",
    "description": "Generic notification + digest layer for CiviCRM. Channel-pluggable (Telegram, Webhook, ntfy.sh, Pushover, Email, CiviCRM activities), template-driven, CiviRules-integrated.",
    "type": "civicrm-ext",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Johannes Filter (civico GmbH)",
            "email": "johannes@civico.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "civico-de/stdlib": "^0.1"
    },
    "require-dev": {
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "phpunit/phpunit": "^9.6"
    },
    "provide": {
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Civi\\Herald\\": "Civi/Herald/"
        },
        "psr-0": {
            "CRM_": "."
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Civi\\Herald\\": "tests/phpunit/Civi/Herald/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/civico-de/stdlib"
        }
    ],
    "extra": {
        "strauss": {
            "target_directory": "vendor",
            "namespace_prefix": "Civi\\Herald\\Vendor\\",
            "classmap_prefix": "Civi_Herald_Vendor_",
            "packages": [
                "civico-de/stdlib"
            ]
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "@php .civikitchen/strauss.php",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    }
}
